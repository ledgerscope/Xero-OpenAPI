    /// <summary>
    /// Provides a default implementation of an asynchronous Api client,
    /// encapsulating general REST accessor use cases.
    /// </summary>
    /// <remarks>
    /// Requests are sent through a single long-lived <see cref="HttpClient"/> so that TCP/TLS connections
    /// are pooled and re-used across requests (and across <see cref="ApiClient"/> instances).
    /// </remarks>
    {{>visibility}} partial class ApiClient : IAsynchronousClient
    {
        private static readonly string[] _defaultAccept = new[] { "application/json", "text/json", "text/x-json", "text/javascript" };

        // Thread-safe and created at most once, on first use (LazyThreadSafetyMode.ExecutionAndPublication)
        private static readonly Lazy<HttpClient> _builtInHttpClient = new Lazy<HttpClient>(CreateDefaultHttpClient);
        private static HttpClient _customHttpClient;

        private readonly String _baseUrl;
        private readonly HttpClient _httpClient;

        /// <summary>
        /// Gets or sets the <see cref="HttpClient"/> shared by every <see cref="ApiClient"/> that isn't given one explicitly.
        /// Set this once at application start-up to control the handler (proxy, connection lifetime, etc.);
        /// the built-in client is then never created.
        /// The client's own Timeout is not used; per-request timeouts come from <see cref="IReadableConfiguration.Timeout"/>.
        /// </summary>
        public static HttpClient DefaultHttpClient
        {
            get { return Volatile.Read(ref _customHttpClient) ?? _builtInHttpClient.Value; }
            set
            {
                ArgumentNullException.ThrowIfNull(value);
                Volatile.Write(ref _customHttpClient, value);
            }
        }

        /// <summary>
        /// Builds the client behind <see cref="DefaultHttpClient"/>. Connections are recycled every few minutes so DNS
        /// changes are picked up, and cookies are disabled so they never leak between requests or tenants.
        /// </summary>
        private static HttpClient CreateDefaultHttpClient()
        {
            var handler = new SocketsHttpHandler
            {
                PooledConnectionLifetime = TimeSpan.FromMinutes(5),
                AutomaticDecompression = DecompressionMethods.All,
                UseCookies = false,
                // Open another HTTP/2 connection rather than queueing once the server's concurrent-stream limit is reached
                EnableMultipleHttp2Connections = true
            };

            return new HttpClient(handler) { Timeout = System.Threading.Timeout.InfiniteTimeSpan };
        }

        /// <summary>
        /// Allows for extending request processing for <see cref="ApiClient"/> generated code.
        /// </summary>
        /// <param name="request">The HTTP request message</param>
        partial void InterceptRequest(HttpRequestMessage request);

        /// <summary>
        /// Allows for extending response processing for <see cref="ApiClient"/> generated code.
        /// </summary>
        /// <param name="request">The HTTP request message</param>
        /// <param name="response">The HTTP response message (null if the request failed before a response was received)</param>
        partial void InterceptResponse(HttpRequestMessage request, HttpResponseMessage response);

        /// <summary>
        /// Initializes a new instance of the <see cref="ApiClient" />, defaulting to the global configurations' base url.
        /// </summary>
        public ApiClient()
            : this({{packageName}}.Client.GlobalConfiguration.Instance.BasePath, null)
        {
        }

        /// <summary>
        /// Initializes a new instance of the <see cref="ApiClient" />
        /// </summary>
        /// <param name="basePath">The target service's base path in URL format.</param>
        /// <exception cref="ArgumentException"></exception>
        public ApiClient(String basePath)
            : this(basePath, null)
        {
        }

        /// <summary>
        /// Initializes a new instance of the <see cref="ApiClient" /> that sends requests through the given <see cref="HttpClient"/>.
        /// </summary>
        /// <param name="basePath">The target service's base path in URL format.</param>
        /// <param name="httpClient">The HttpClient to use, or null to use <see cref="DefaultHttpClient"/>.
        /// Its Timeout should be at least <see cref="IReadableConfiguration.Timeout"/>, as that is applied per request.</param>
        /// <exception cref="ArgumentException"></exception>
        public ApiClient(String basePath, HttpClient httpClient)
        {
            if (String.IsNullOrEmpty(basePath))
                throw new ArgumentException("basePath cannot be empty");

            _baseUrl = basePath;
            _httpClient = httpClient;
        }

        private HttpClient HttpClient
        {
            get { return _httpClient ?? DefaultHttpClient; }
        }

        /// <summary>
        /// Constructs the System.Net.Http version of an http method
        /// </summary>
        /// <param name="method">Swagger Client Custom HttpMethod</param>
        /// <returns>System.Net.Http's HttpMethod instance.</returns>
        /// <exception cref="ArgumentOutOfRangeException"></exception>
        private SystemHttpMethod Method(HttpMethod method)
        {
            switch (method)
            {
                case HttpMethod.Get:
                    return SystemHttpMethod.Get;
                case HttpMethod.Post:
                    return SystemHttpMethod.Post;
                case HttpMethod.Put:
                    return SystemHttpMethod.Put;
                case HttpMethod.Delete:
                    return SystemHttpMethod.Delete;
                case HttpMethod.Head:
                    return SystemHttpMethod.Head;
                case HttpMethod.Options:
                    return SystemHttpMethod.Options;
                case HttpMethod.Patch:
                    return SystemHttpMethod.Patch;
                default:
                    throw new ArgumentOutOfRangeException("method", method, null);
            }
        }

        /// <summary>
        /// Builds the absolute request URI from the base url, the resource path, and the path and query parameters.
        /// </summary>
        private Uri BuildUri(String path, RequestOptions options)
        {
            var resource = path;
            if (options.PathParameters != null)
            {
                foreach (var pathParam in options.PathParameters)
                {
                    resource = resource.Replace("{" + pathParam.Key + "}", Uri.EscapeDataString(pathParam.Value ?? String.Empty));
                }
            }

            var url = new StringBuilder(_baseUrl.TrimEnd('/'));
            if (!String.IsNullOrEmpty(resource))
            {
                url.Append('/').Append(resource.TrimStart('/'));
            }

            if (options.QueryParameters != null)
            {
                var separator = url.ToString().Contains("?") ? '&' : '?';
                foreach (var queryParam in options.QueryParameters.AllKeys)
                {
                    var values = options.QueryParameters.GetValues(queryParam);
                    if (values == null) continue;
                    foreach (var value in values)
                    {
                        url.Append(separator)
                            .Append(Uri.EscapeDataString(queryParam))
                            .Append('=')
                            .Append(Uri.EscapeDataString(value ?? String.Empty));
                        separator = '&';
                    }
                }
            }

            return new Uri(url.ToString());
        }

        /// <summary>
        /// Provides all logic for constructing a new <see cref="HttpRequestMessage"/>.
        /// At this point, all information for querying the service is known. Here, it is simply
        /// mapped into the HTTP request.
        /// </summary>
        /// <param name="method">The http verb.</param>
        /// <param name="path">The target path (or resource).</param>
        /// <param name="options">The additional request options.</param>
        /// <param name="configuration">A per-request configuration object. It is assumed that any merge with
        /// GlobalConfiguration has been done before calling this method.</param>
        /// <returns>[private] A new HttpRequestMessage instance.</returns>
        /// <exception cref="ArgumentNullException"></exception>
        private HttpRequestMessage newRequest(
            HttpMethod method,
            String path,
            RequestOptions options,
            IReadableConfiguration configuration)
        {
            if (path == null) throw new ArgumentNullException("path");
            if (options == null) throw new ArgumentNullException("options");
            if (configuration == null) throw new ArgumentNullException("configuration");

            var request = new HttpRequestMessage(Method(method), BuildUri(path, options))
            {
                // Prefer HTTP/2 (negotiated via ALPN); falls back to HTTP/1.1 if the server doesn't support it
                Version = HttpVersion.Version20,
                VersionPolicy = HttpVersionPolicy.RequestVersionOrLower
            };

            var hasAccept = false;
            if (options.HeaderParameters != null)
            {
                foreach (var headerParam in options.HeaderParameters.AllKeys)
                {
                    // Content-Type is a content header and is decided by the body below
                    if (String.Equals(headerParam, "Content-Type", StringComparison.OrdinalIgnoreCase)) continue;

                    var values = options.HeaderParameters.GetValues(headerParam);
                    if (values == null) continue;
                    if (String.Equals(headerParam, "Accept", StringComparison.OrdinalIgnoreCase)) hasAccept = true;
                    request.Headers.TryAddWithoutValidation(headerParam, values);
                }
            }

            if (!hasAccept)
            {
                request.Headers.TryAddWithoutValidation("Accept", _defaultAccept);
            }

            if (configuration.UserAgent != null)
            {
                request.Headers.TryAddWithoutValidation("User-Agent", configuration.UserAgent);
            }

            if (options.Cookies != null && options.Cookies.Count > 0)
            {
                request.Headers.TryAddWithoutValidation("Cookie", String.Join("; ", options.Cookies.Select(c => c.Name + "=" + c.Value)));
            }

            request.Content = newContent(options, configuration);

            return request;
        }

        private HttpContent newContent(RequestOptions options, IReadableConfiguration configuration)
        {
            var hasFiles = options.FileParameters != null && options.FileParameters.Count > 0;
            var hasForm = options.FormParameters != null && options.FormParameters.Count > 0;

            if (options.Data != null)
            {
                HttpContent body;
                if (options.Data is byte[] bytes)
                {
                    body = new ByteArrayContent(bytes);
                    body.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
                }
                else if (options.Data is Stream dataStream)
                {
                    body = new StreamContent(dataStream);
                    body.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
                }
                else
                {
                    body = new StringContent(new CustomJsonCodec(configuration).Serialize(options.Data), Encoding.UTF8);
                    body.Headers.ContentType = new MediaTypeHeaderValue("application/json");
                }
                return body;
            }

            if (hasFiles)
            {
                var boundary = "-------------------------" + DateTime.UtcNow.Ticks.ToString("x", CultureInfo.InvariantCulture);
                var multipart = new MultipartFormDataContent(boundary);
                // Send the boundary unquoted, as most servers expect
                multipart.Headers.ContentType = MediaTypeHeaderValue.Parse("multipart/form-data; boundary=" + boundary);

                if (hasForm)
                {
                    foreach (var formParam in options.FormParameters)
                    {
                        var part = new StringContent(formParam.Value ?? String.Empty);
                        part.Headers.ContentType = null;
                        part.Headers.ContentDisposition = new ContentDispositionHeaderValue("form-data") { Name = "\"" + formParam.Key + "\"" };
                        multipart.Add(part);
                    }
                }

                foreach (var fileParam in options.FileParameters)
                {
                    var bytes = ClientUtils.ReadAsBytes(fileParam.Contents);
                    var fileStream = fileParam.Contents as FileStream;
                    var fileName = fileStream != null ? System.IO.Path.GetFileName(fileStream.Name) : fileParam.Name;

                    var part = new ByteArrayContent(bytes);
                    part.Headers.ContentDisposition = new ContentDispositionHeaderValue("form-data")
                    {
                        Name = "\"" + fileParam.Key + "\"",
                        FileName = "\"" + fileName + "\""
                    };
                    part.Headers.ContentType = MediaTypeHeaderValue.Parse(String.IsNullOrEmpty(fileParam.ContentType) ? "application/octet-stream" : fileParam.ContentType);
                    multipart.Add(part);
                }

                return multipart;
            }

            if (hasForm)
            {
                return new FormUrlEncodedContent(options.FormParameters);
            }

            return null;
        }

        private static NameValueCollection readHeaders(HttpResponseMessage response)
        {
            var headers = new NameValueCollection(StringComparer.OrdinalIgnoreCase);
            foreach (var header in response.Headers)
            {
                foreach (var value in header.Value)
                {
                    headers.Add(header.Key, value);
                }
            }

            if (response.Content != null)
            {
                foreach (var header in response.Content.Headers)
                {
                    foreach (var value in header.Value)
                    {
                        headers.Add(header.Key, value);
                    }
                }
            }

            return headers;
        }

        private static List<Cookie> readCookies(HttpResponseMessage response, Uri requestUri)
        {
            var cookies = new List<Cookie>();
            IEnumerable<string> setCookies;
            if (!response.Headers.TryGetValues("Set-Cookie", out setCookies)) return cookies;

            var container = new CookieContainer();
            foreach (var setCookie in setCookies)
            {
                try
                {
                    container.SetCookies(requestUri, setCookie);
                }
                catch (CookieException)
                {
                    // Ignore malformed cookies, as a browser would
                }
            }

            foreach (Cookie cookie in container.GetCookies(requestUri))
            {
                cookies.Add(cookie);
            }

            return cookies;
        }

        private static string decodeContent(byte[] rawBytes, HttpContent content)
        {
            if (rawBytes == null || rawBytes.Length == 0) return String.Empty;

            Encoding encoding = Encoding.UTF8;
            var charset = content?.Headers?.ContentType?.CharSet;
            if (!String.IsNullOrEmpty(charset))
            {
                try
                {
                    encoding = Encoding.GetEncoding(charset.Trim('"'));
                }
                catch (ArgumentException)
                {
                    // Unknown charset, stick with UTF-8
                }
            }

            return encoding.GetString(rawBytes);
        }

        private async Task<ApiResponse<T>> Exec<T>(HttpRequestMessage req, IReadableConfiguration configuration, CancellationToken cancellationToken)
        {
            using (req)
            using (var timeoutCts = new CancellationTokenSource())
            using (var linkedCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, timeoutCts.Token))
            {
                if (configuration.Timeout > 0)
                {
                    timeoutCts.CancelAfter(configuration.Timeout);
                }

                InterceptRequest(req);

                HttpResponseMessage response;
                byte[] rawBytes;
                try
                {
                    response = await HttpClient.SendAsync(req, HttpCompletionOption.ResponseContentRead, linkedCts.Token).ConfigureAwait(false);
                    rawBytes = response.Content != null
                        ? await response.Content.ReadAsByteArrayAsync(linkedCts.Token).ConfigureAwait(false)
                        : new byte[0];
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    throw;
                }
                catch (Exception ex) when (ex is HttpRequestException || ex is OperationCanceledException || ex is IOException)
                {
                    // Transport failures (including timeouts) are reported on the response rather than thrown,
                    // leaving it to the ExceptionFactory to decide what to do with them.
                    InterceptResponse(req, null);
                    var message = ex is OperationCanceledException
                        ? String.Format("The request timed out after {0}ms.", configuration.Timeout)
                        : ex.Message;
                    return new ApiResponse<T>(0, new NameValueCollection(StringComparer.OrdinalIgnoreCase), default(T))
                    {
                        ErrorText = message,
                        Cookies = new List<Cookie>(),
                        Content = String.Empty
                    };
                }

                using (response)
                {
                    InterceptResponse(req, response);

                    var headers = readHeaders(response);
                    var content = decodeContent(rawBytes, response.Content);

                    T data = default(T);
                    string errorText = null;
                    try
                    {
                        data = (T)new CustomJsonCodec(configuration).Deserialize(rawBytes, content, headers, typeof(T));
                    }
                    catch (Exception ex)
                    {
                        // Matches previous behaviour: a body that can't be deserialized (e.g. an HTML error page)
                        // leaves Data unset and is reported via ErrorText, not thrown.
                        errorText = ex.Message;
                    }

                    return new ApiResponse<T>(response.StatusCode, headers, data)
                    {
                        ErrorText = errorText,
                        Cookies = readCookies(response, req.RequestUri),
                        Content = content
                    };
                }
            }
        }

